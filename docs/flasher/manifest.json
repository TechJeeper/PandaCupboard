{
  "name": "PandaFarm",
  "version": "0.3.1",
  "description": "Bambu Lab and Klipper farm dashboard for BTT K-Touch / PandaTouch — Studio-style farm list with pause, resume, stop, and LAN status",
  "chip": "ESP32-S3",
  "hardware": "BTT K-Touch / PandaTouch (ESP32-S3, 8 MB PSRAM)",
  "github": {
    "owner": "TechJeeper",
    "repo": "PandaFarm"
  },
  "flash": {
    "mode": "keep",
    "freq": "keep",
    "size": "keep",
    "compress": false,
    "eraseAll": true
  },
  "baudRate": 115200,
  "firmwareLocal": {
    "base": "./firmware/"
  },
  "firmwareCdn": {
    "owner": "TechJeeper",
    "repo": "PandaFarm",
    "ref": "main",
    "path": "docs/flasher/firmware/"
  },
  "files": [
    { "asset": "pandafarm-bootloader.bin", "offset": 0 },
    { "asset": "pandafarm-partitions.bin", "offset": 32768 },
    { "asset": "pandafarm-boot_app0.bin", "offset": 57344, "optional": true },
    { "asset": "pandafarm-firmware.bin", "offset": 65536 }
  ],
  "localFallback": {
    "bootloader.bin": 0,
    "partitions.bin": 32768,
    "boot_app0.bin": 57344,
    "firmware.bin": 65536
  },
  "usbFilters": [
    { "usbVendorId": 6790 },
    { "usbVendorId": 12346 },
    { "usbVendorId": 4292 },
    { "usbVendorId": 1027 },
    { "usbVendorId": 1659 }
  ]
}
